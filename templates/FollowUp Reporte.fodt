<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="paragraph">
<style:text-properties style:font-name="Liberation Sans" fo:font-size="10pt" fo:language="es" fo:country="DO"/>
</style:default-style>
<style:style style:name="DocTitle" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.4cm"/>
<style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="SectionHeading" style:family="paragraph">
<style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="0.2cm" fo:border-bottom="0.02cm solid #666666" fo:padding-bottom="0.05cm"/>
<style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="FieldLine" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.08cm"/>
</style:style>
<style:style style:name="Label" style:family="text">
<style:text-properties fo:font-weight="bold"/>
</style:style>
</office:styles>
<office:automatic-styles>
<style:style style:name="EvidenceTable" style:family="table">
<style:table-properties style:width="16cm"/>
</style:style>
<style:style style:name="EvColHead" style:family="table-column"/>
<style:style style:name="HeaderCell" style:family="table-cell">
<style:table-cell-properties fo:padding="0.08cm" fo:border="0.01cm solid #999999" fo:background-color="#dddddd"/>
</style:style>
<style:style style:name="DataCell" style:family="table-cell">
<style:table-cell-properties fo:padding="0.08cm" fo:border="0.01cm solid #999999"/>
</style:style>
</office:automatic-styles>
<office:body>
<office:text>
<text:p text:style-name="DocTitle">${labels.followupReport}</text:p>

<text:p text:style-name="SectionHeading">${labels.identification}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.followupId} </text:span>${followUpId}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.findingId} </text:span>${findingId}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.cAPId} </text:span>${capId}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.location} </text:span>${locationName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.specialty} </text:span>${specialtyName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.provider} </text:span>${providerName}</text:p>

<text:p text:style-name="SectionHeading">${labels.followupDetail}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.followupType} </text:span>${followUpType}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.followupDate} </text:span>${followUpDate}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.percentComplete} </text:span>${percentComplete}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.currentResidualRisk} </text:span>${currentResidualRisk}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.comment} </text:span>${followUpComment}</text:p>

<text:p text:style-name="SectionHeading">${labels.closure}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.effectivenessConfirmed} </text:span>${effectivenessConfirmed}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.closureVerificationMethod} </text:span>${closureVerificationMethod}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.followupClosureDate} </text:span>${followUpClosureDate}</text:p>

<text:p text:style-name="SectionHeading">${labels.evidence}</text:p>
<table:table table:name="FollowUpEvidenceTable" table:style-name="EvidenceTable">
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-row>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.evidenceId}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.type}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.role}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.source}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.collectionDate}</text:p></table:table-cell>
</table:table-row>
[#list evidenceItems as evidence]
<table:table-row>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceId}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceType}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceRole}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.source}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.collectionDate}</text:p></table:table-cell>
</table:table-row>
[/#list]
</table:table>

</office:text>
</office:body>
</office:document>
