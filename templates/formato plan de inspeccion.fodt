   </table:table-cell>
   <table:covered-table-cell/>
   <table:covered-table-cell/>
  </table:table-row>
  <table:table-row table:style-name="RptHeader.R2">
   <table:covered-table-cell/>
   <table:table-cell table:style-name="RptHeader.Cell" table:number-rows-spanned="2" office:value-type="string">
    <text:p text:style-name="RptHeaderTitlePara"><text:span text:style-name="RptHeaderTitleText">${labels.docTitle}</text:span></text:p>
    <text:p text:style-name="RptHeaderSubtitlePara"><text:span text:style-name="RptHeaderSubtitleText">${labels.docSubtitle}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderLabelPara"><text:span text:style-name="RptHeaderLabelText">${labels.codeLabel}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" table:number-columns-spanned="2" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlCode}</text:span></text:p>
   </table:table-cell>
   <table:covered-table-cell/>
  </table:table-row>
  <table:table-row table:style-name="RptHeader.R3">
   <table:covered-table-cell/>
   <table:covered-table-cell/>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderLabelPara"><text:span text:style-name="RptHeaderLabelText">${labels.versionLabel}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlVersion}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlDate}</text:span></text:p>
   </table:table-cell>
  </table:table-row>
 </table:table>
</style:header>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:text text:use-soft-page-breaks="true">
   <office:forms form:automatic-focus="false" form:apply-design-mode="false">
    <form:form form:name="Form" form:apply-filter="true" form:command-type="table" form:control-implementation="ooo:com.sun.star.form.component.Form" office:target-frame="">
     <form:properties>
      <form:property form:property-name="PropertyChangeNotificationEnabled" office:value-type="boolean" office:boolean-value="true"/>
      <form:property form:property-name="TargetURL" office:value-type="string" office:string-value=""/>
     </form:properties>
    </form:form>
   </office:forms>
   <text:sequence-decls>
    <text:sequence-decl text:display-outline-level="0" text:name="Illustration"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Table"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Text"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Drawing"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <table:table table:name="Table2" table:style-name="Table2">
    <table:table-column table:style-name="Table2.A"/>
    <table:table-column table:style-name="Table2.B"/>
    <table:table-column table:style-name="Table2.C"/>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.inspectionNoLabel}</text:span>${inspectionNo}</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.B1" table:number-columns-spanned="2" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">${locationName}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row table:style-name="Table2.2">
     <table:table-cell table:style-name="Table2.A2" office:value-type="string">
      <text:p text:style-name="P13">${labels.entitiesToInspectLabel}</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.B2" table:number-columns-spanned="2" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">[#list providers as provider]<text:span text:style-name="T14">${provider.name}</text:span></text:p>
      <text:p text:style-name="Table_20_Contents">[#list provider.services as service] <text:s text:c="3"/>${service.name}[/#list]</text:p>
      <text:p text:style-name="Table_20_Contents">[/#list]</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.objectivesLabel}</text:span>${objective}</text:p>
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.scopeLabel}</text:span>${scope}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P14">${labels.referenceDocsUsageLabel}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P14"/>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P14">${labels.teamMembersLabel}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.mainSpecialistLabel}</text:span>${mainInspector}</text:p>
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.alternateSpecialistLabel}</text:span>${secondaryInspector}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">[#list providers as provider][#list provider.services as service]<text:span text:style-name="T14">${service.name}</text:span></text:p>
      <text:p text:style-name="P15">[#list service.specialties as specialty][#list specialty.inspectors as inspector]${inspector} (${specialty.name})</text:p>
      <text:p text:style-name="P15">[/#list][/#list]</text:p>
      <text:p text:style-name="P16">[/#list][/#list]</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.proposedInspectionDateLabel}</text:span>${startDate}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.proposedOpeningMeetingLabel}</text:span>${openingDateTime}</text:p>
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.proposedClosingMeetingLabel}</text:span>${closureDateTime}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A3" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P17">${labels.interviewScheduleLabel}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A12" table:number-columns-spanned="2" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">[#list providers as provider][#list provider.services as service]${service.name}</text:p>
      <text:p text:style-name="Table_20_Contents">[/#list][/#list]</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:table-cell table:style-name="Table2.C12" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">[#list schedules as schedule]</text:p>
      <text:p text:style-name="Table_20_Contents">${schedule.startDateTime} - ${schedule.endDateTime}</text:p>
      <text:p text:style-name="Table_20_Contents">[/#list]</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A13" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P17">${labels.finalReportDistributionListLabel}</text:p>
      <text:p text:style-name="Table_20_Contents">[#list providers as provider]<text:span text:style-name="T14">${provider.contact.name}</text:span>, ${provider.contact.position} </text:p>
      <text:p text:style-name="Table_20_Contents">[/#list]</text:p>
      <text:p text:style-name="P17">${labels.finalReportDeliveryDateLabel}</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <table:table table:name="Table3" table:style-name="Table3">
    <table:table-column table:style-name="Table3.A"/>
    <table:table-column table:style-name="Table3.B"/>
    <table:table-row table:style-name="Table3.1">
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.preparedByLabel}</text:span>${mainInspector}</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B1" office:value-type="string">
      <text:p text:style-name="P18">${labels.approvedByLabel}<text:span text:style-name="T15"> </text:span><text:span text:style-name="T16">${planApprovedBy}</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T14">${labels.positionLabel}</text:span> ${labels.leadSpecialistPositionText}${inspectionNo}</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P18">${labels.positionLabel} <text:span text:style-name="T16">${planApprovedByPosition}</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.3">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P18">${labels.dateLabel} <text:span text:style-name="T15">${signatureDate}</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P18">${labels.dateLabel} <text:span text:style-name="T15">${signatureDate}</text:span><text:span text:style-name="T15"><text:s/></text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table3.4">
     <table:table-cell table:style-name="Table3.A2" office:value-type="string">
      <text:p text:style-name="P19">${labels.signatureLabel}<text:soft-page-break/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.B2" office:value-type="string">
      <text:p text:style-name="P18">${labels.signatureLabel}</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P20" loext:marker-style-name="T17"/>
  </office:text>
 </office:body>
</office:document>
