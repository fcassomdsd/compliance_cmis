<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="paragraph">
<style:text-properties style:font-name="Liberation Sans" fo:font-size="10pt" fo:language="es" fo:country="DO"/>
</style:default-style>
<style:style style:name="DocTitle" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.4cm"/>
<style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="SectionHeading" style:family="paragraph">
<style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="0.2cm" fo:border-bottom="0.02cm solid #666666" fo:padding-bottom="0.05cm"/>
<style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="SubHeading" style:family="paragraph">
<style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.1cm"/>
<style:text-properties fo:font-size="10pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="FieldLine" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.08cm"/>
</style:style>
<style:style style:name="Label" style:family="text">
<style:text-properties fo:font-weight="bold"/>
</style:style>
</office:styles>
<office:automatic-styles>
<style:style style:name="EvidenceTable" style:family="table">
<style:table-properties style:width="16cm"/>
</style:style>
<style:style style:name="EvColHead" style:family="table-column"/>
<style:style style:name="HeaderCell" style:family="table-cell">
<style:table-cell-properties fo:padding="0.08cm" fo:border="0.01cm solid #999999" fo:background-color="#dddddd"/>
</style:style>
<style:style style:name="DataCell" style:family="table-cell">
<style:table-cell-properties fo:padding="0.08cm" fo:border="0.01cm solid #999999"/>
</style:style>

<style:style style:name="RptHeader" style:family="table"><style:table-properties style:width="7.2in" table:align="left" style:writing-mode="page"/></style:style>
<style:style style:name="RptHeader.A" style:family="table-column"><style:table-column-properties style:column-width="1.55in"/></style:style>
<style:style style:name="RptHeader.B" style:family="table-column"><style:table-column-properties style:column-width="2.9in"/></style:style>
<style:style style:name="RptHeader.C" style:family="table-column"><style:table-column-properties style:column-width="0.65in"/></style:style>
<style:style style:name="RptHeader.D" style:family="table-column"><style:table-column-properties style:column-width="0.4in"/></style:style>
<style:style style:name="RptHeader.E" style:family="table-column"><style:table-column-properties style:column-width="1.7in"/></style:style>
<style:style style:name="RptHeader.R1" style:family="table-row"><style:table-row-properties style:min-row-height="0.4354in" fo:keep-together="auto"/></style:style>
<style:style style:name="RptHeader.R2" style:family="table-row"><style:table-row-properties style:min-row-height="0.2951in" fo:keep-together="auto"/></style:style>
<style:style style:name="RptHeader.R3" style:family="table-row"><style:table-row-properties style:min-row-height="0.1875in" fo:keep-together="auto"/></style:style>
<style:style style:name="RptHeader.Cell" style:family="table-cell"><style:table-cell-properties fo:padding-left="0.0104in" fo:padding-right="0.0104in" fo:padding-top="0in" fo:padding-bottom="0in" fo:border="1.5pt solid #000000"/></style:style>
<style:style style:name="RptHeaderLogoPara" style:family="paragraph"><style:paragraph-properties fo:margin-left="0.0866in" fo:margin-top="0.02in" fo:margin-bottom="0in"/></style:style>
<style:style style:name="RptHeaderEntityPara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.0764in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderKickerPara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.0764in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderTitlePara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.1189in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderSubtitlePara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.02in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderLabelPara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.0354in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderValuePara" style:family="paragraph"><style:paragraph-properties fo:margin-top="0.0354in" fo:margin-bottom="0in" fo:text-align="center" style:justify-single-word="false"/></style:style>
<style:style style:name="RptHeaderEntityText" style:family="text"><style:text-properties fo:font-size="9pt" fo:font-weight="bold"/></style:style>
<style:style style:name="RptHeaderKickerText" style:family="text"><style:text-properties fo:font-size="10pt" fo:font-weight="bold"/></style:style>
<style:style style:name="RptHeaderTitleText" style:family="text"><style:text-properties fo:font-size="10pt" fo:font-weight="bold"/></style:style>
<style:style style:name="RptHeaderSubtitleText" style:family="text"><style:text-properties fo:font-size="8pt"/></style:style>
<style:style style:name="RptHeaderLabelText" style:family="text"><style:text-properties fo:font-size="9pt"/></style:style>
<style:style style:name="RptHeaderValueText" style:family="text"><style:text-properties fo:font-size="9pt" fo:font-weight="bold"/></style:style>
<style:style style:name="RptHeaderLogoFrame" style:family="graphic"><style:graphic-properties style:vertical-pos="top" style:vertical-rel="baseline" fo:background-color="transparent" draw:fill="none" style:mirror="none"/></style:style>
<style:page-layout style:name="RptHeaderPageLayout">
<style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:num-format="1" style:print-orientation="portrait" fo:margin-top="1.1in" fo:margin-bottom="0.6in" fo:margin-left="0.6in" fo:margin-right="0.6in" style:writing-mode="lr-tb"/>
<style:header-style><style:header-footer-properties fo:min-height="0.02in" fo:margin-left="0in" fo:margin-right="0in" fo:margin-bottom="0.1in" fo:background-color="transparent" style:dynamic-spacing="true" draw:fill="none"/></style:header-style>
</style:page-layout>
</office:automatic-styles>
<office:master-styles>
<style:master-page style:name="Standard" style:page-layout-name="RptHeaderPageLayout">
<style:header>
 <table:table table:name="RptHeader" table:style-name="RptHeader">
  <table:table-column table:style-name="RptHeader.A"/>
  <table:table-column table:style-name="RptHeader.B"/>
  <table:table-column table:style-name="RptHeader.C"/>
  <table:table-column table:style-name="RptHeader.D"/>
  <table:table-column table:style-name="RptHeader.E"/>
  <table:table-row table:style-name="RptHeader.R1">
   <table:table-cell table:style-name="RptHeader.Cell" table:number-rows-spanned="3" office:value-type="string">
    <text:p text:style-name="RptHeaderLogoPara"><draw:frame draw:style-name="RptHeaderLogoFrame" draw:name="EntityLogo" text:anchor-type="as-char" svg:width="1.2857in" svg:height="0.8571in" draw:z-index="1"><draw:image draw:mime-type="${entityLogoMimeType}"><office:binary-data>${entityLogoBase64}</office:binary-data></draw:image></draw:frame></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderEntityPara"><text:span text:style-name="RptHeaderEntityText">${entityName}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" table:number-columns-spanned="3" office:value-type="string">
    <text:p text:style-name="RptHeaderKickerPara"><text:span text:style-name="RptHeaderKickerText">${labels.formHeading}</text:span></text:p>
   </table:table-cell>
   <table:covered-table-cell/>
   <table:covered-table-cell/>
  </table:table-row>
  <table:table-row table:style-name="RptHeader.R2">
   <table:covered-table-cell/>
   <table:table-cell table:style-name="RptHeader.Cell" table:number-rows-spanned="2" office:value-type="string">
    <text:p text:style-name="RptHeaderTitlePara"><text:span text:style-name="RptHeaderTitleText">${labels.docTitle}</text:span></text:p>
    <text:p text:style-name="RptHeaderSubtitlePara"><text:span text:style-name="RptHeaderSubtitleText">${labels.docSubtitle}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderLabelPara"><text:span text:style-name="RptHeaderLabelText">${labels.codeLabel}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" table:number-columns-spanned="2" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlCode}</text:span></text:p>
   </table:table-cell>
   <table:covered-table-cell/>
  </table:table-row>
  <table:table-row table:style-name="RptHeader.R3">
   <table:covered-table-cell/>
   <table:covered-table-cell/>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderLabelPara"><text:span text:style-name="RptHeaderLabelText">${labels.versionLabel}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlVersion}</text:span></text:p>
   </table:table-cell>
   <table:table-cell table:style-name="RptHeader.Cell" office:value-type="string">
    <text:p text:style-name="RptHeaderValuePara"><text:span text:style-name="RptHeaderValueText">${docControlDate}</text:span></text:p>
   </table:table-cell>
  </table:table-row>
 </table:table>
</style:header>
</style:master-page>
</office:master-styles>
<office:body>
<office:text>
<text:p text:style-name="DocTitle">${labels.inspectionChecklist}</text:p>

<text:p text:style-name="SectionHeading">${labels.generalInformation}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.inspectionCode} </text:span>${checklist.inspectionCode}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.location} </text:span>${checklist.locationName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.specialty} </text:span>${checklist.specialtyName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.provider} </text:span>${checklist.providerName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.scope} </text:span>${checklist.scope}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.completionDate} </text:span>${checklist.completionDate}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.interviewee} </text:span>${checklist.interviewee}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.checklistId} </text:span>${checklist.checklistId}</text:p>

<text:p text:style-name="SectionHeading">${labels.checklistItems}</text:p>
[#list items as item]
<text:p text:style-name="SubHeading">${item.itemCode} — ${item.requirementText}${item.requirement}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.verificationMethod} </text:span>${item.itemVerificationMethod}${item.verificationMethod}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.complianceStatus} </text:span>${item.complianceStatus}${item.compliance}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.riskLevel} </text:span>${item.riskClassification}${item.nominalRisk}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.inspectorComment} </text:span>${item.inspectorComment}${item.comment}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.iCAOReference} </text:span>${item.reference.icaoReference}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.nationalRegulation} </text:span>${item.reference.nationalRegulation}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.regulationItem} </text:span>${item.reference.regulationItem}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.openPriorFinding} </text:span>${item.hasOpenPriorFinding}</text:p>
<table:table table:name="EvidenceTable_${item.itemCode}" table:style-name="EvidenceTable">
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-column table:style-name="EvColHead"/>
<table:table-row>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.evidenceId}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.type}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.role}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.source}</text:p></table:table-cell>
<table:table-cell table:style-name="HeaderCell" office:value-type="string"><text:p>${labels.collectionDate}</text:p></table:table-cell>
</table:table-row>
[#list item.evidenceItems as evidence]
<table:table-row>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceId}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceType}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.evidenceRole}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.source}</text:p></table:table-cell>
<table:table-cell table:style-name="DataCell" office:value-type="string"><text:p>${evidence.collectionDate}</text:p></table:table-cell>
</table:table-row>
[/#list]
</table:table>
<text:p text:style-name="FieldLine"></text:p>
[/#list]

</office:text>
</office:body>
</office:document>
