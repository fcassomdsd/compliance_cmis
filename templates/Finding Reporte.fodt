<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="paragraph">
<style:text-properties style:font-name="Liberation Sans" fo:font-size="10pt" fo:language="es" fo:country="DO"/>
</style:default-style>
<style:style style:name="DocTitle" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.4cm"/>
<style:text-properties fo:font-size="16pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="SectionHeading" style:family="paragraph">
<style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="0.2cm" fo:border-bottom="0.02cm solid #666666" fo:padding-bottom="0.05cm"/>
<style:text-properties fo:font-size="13pt" fo:font-weight="bold"/>
</style:style>
<style:style style:name="FieldLine" style:family="paragraph">
<style:paragraph-properties fo:margin-bottom="0.08cm"/>
</style:style>
<style:style style:name="Label" style:family="text">
<style:text-properties fo:font-weight="bold"/>
</style:style>
</office:styles>
<office:body>
<office:text>
<text:p text:style-name="DocTitle">${labels.inspectionFinding}</text:p>

<text:p text:style-name="SectionHeading">${labels.identification}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.findingId} </text:span>${findingId}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.checklistItem} </text:span>${checklistItemCode}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.location} </text:span>${locationName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.specialty} </text:span>${specialtyName}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.provider} </text:span>${providerName}</text:p>

<text:p text:style-name="SectionHeading">${labels.findingDetail}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.description} </text:span>${description}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.requirementBreached} </text:span>${requirementBreached}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.iCAOReference} </text:span>${icaoReference}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.nationalRegulation} </text:span>${nationalRegulation}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.regulationItem} </text:span>${regulationItem}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.level} </text:span>${findingLevel}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.severity} </text:span>${findingSeverity}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.riskClassification} </text:span>${riskClassification}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.targetResidualRisk} </text:span>${targetResidualRisk}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.achievedResidualRisk} </text:span>${achievedResidualRisk}</text:p>

<text:p text:style-name="SectionHeading">${labels.statusAndDates}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.status} </text:span>${findingStatus}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.dateIssued} </text:span>${dateIssued}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.cAPSubmissionDeadline} </text:span>${submissionDeadline}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.resolutionDeadline} </text:span>${resolutionDeadline}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.closureDate} </text:span>${findingClosureDate}</text:p>

<text:p text:style-name="SectionHeading">${labels.correctiveAction}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.cAPId} </text:span>${correctiveAction.capId}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.proposedAction} </text:span>${correctiveAction.proposedAction}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.responsibleEntity} </text:span>${correctiveAction.responsibleEntity}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.dueDate} </text:span>${correctiveAction.dueDate}</text:p>
<text:p text:style-name="FieldLine"><text:span text:style-name="Label">${labels.acceptanceStatus} </text:span>${correctiveAction.acceptanceStatus}</text:p>

</office:text>
</office:body>
</office:document>
