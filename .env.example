# compliance_cmis - copy to .env before `docker compose up`.
#
# docker compose now REFUSES TO START when any of the four secrets below is
# unset, rather than falling back to the weak default it used to carry. Those
# defaults were exactly these values, committed here and therefore public, so
# an operator who never created a .env got a running stack with a password of
# "alfresco" and a Solr shared secret of "secret" and no indication anything
# was wrong. Failing loudly is the point of the change.

# Docker image versions
#
# Every image in docker-compose.yml is pinned by DIGEST as well as tag
# (`name:tag@sha256:...`). A tag is a mutable pointer: upstream can re-push
# 25.2.0 or 16.5 at any time, so a tag-only pin does not describe a
# reproducible stack. The digest does, and the tag stays beside it so the
# version is still readable at a glance.
#
# This file used to declare ALFRESCO_CE_TAG, SEARCH_CE_TAG, SHARE_TAG,
# TRANSFORM_ENGINE_TAG and ACTIVEMQ_TAG. None of them was ever referenced by
# the compose file, which hardcoded those versions -- so editing them here
# looked like it changed the stack and did nothing at all. They are removed
# rather than wired up: with digests in play a version is two values that
# must agree, and splitting that pair across a .env invites a mismatch that
# only shows up as a confusing pull. To change a version, edit
# docker-compose.yml and set both halves together.
#
# POSTGRES_TAG is the one that WAS consumed, so it stays, now with a matching
# digest override. Override both or neither.
POSTGRES_TAG=16.5
POSTGRES_DIGEST=sha256:53f3e608f9475ce120ced2d0f430b89458d7faa28530e0b0977a6af64d294877

# Security secrets.
#
# THESE FOUR VALUES ARE PUBLIC. They are committed to this repository, so
# everyone who has cloned it knows them. They exist so the demo starts; they
# are not secrets and must be replaced before this stack is reachable by
# anyone you do not trust. Generate replacements with `openssl rand -hex 32`.
#
# One caveat when replacing them: METADATA_KEYSTORE_PASSWORD and
# METADATA_KEYSTORE_METADATA_PASSWORD encrypt Alfresco's stored metadata.
# Changing them on an instance that already holds data makes that data
# undecryptable. Set them before first start, or re-key deliberately.
# SOLR_SECRET must match on the alfresco and solr6 services.
METADATA_KEYSTORE_PASSWORD=mp6yc0UD9e
METADATA_KEYSTORE_METADATA_PASSWORD=oKIWzVdEdA
DB_PASSWORD=alfresco
SOLR_SECRET=secret

# Server properties
SERVER_NAME=localhost

# Binding properties
BIND_IP_NGINX=0.0.0.0
BIND_IP_FTP=0.0.0.0
