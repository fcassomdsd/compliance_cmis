<model name="vso:vsoModel"
       xmlns="http://www.alfresco.org/model/dictionary/1.0">

  <description>Operational Safety Oversight Model for Alfresco 25.2</description>
  <author>VSO Team</author>
  <version>1.5</version>

  <!-- ========================================================= -->
  <!-- Imports -->
  <!-- ========================================================= -->
  <imports>
    <import uri="http://www.alfresco.org/model/dictionary/1.0" prefix="d"/>
    <import uri="http://www.alfresco.org/model/content/1.0" prefix="cm"/>
  </imports>

  <!-- ========================================================= -->
  <!-- Namespace -->
  <!-- ========================================================= -->
  <namespaces>
    <namespace uri="http://example.org/model/operational-safety/1.0"
               prefix="vso"/>
  </namespaces>

  <!-- ========================================================= -->
  <!-- Constraints -->
  <!-- ========================================================= -->
  <constraints>
    <constraint name="vso:complianceStatusList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Compliant</value>
          <value>Non-Compliant</value>
          <value>Not Applicable</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:findingLevelList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Non-Compliance</value>
          <value>Observation</value>
          <value>Recommendation</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:riskLevelList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Low</value>
          <value>Medium</value>
          <value>High</value>
          <value>Critical</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:ceList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>CE-1</value>
          <value>CE-2</value>
          <value>CE-3</value>
          <value>CE-4</value>
          <value>CE-5</value>
          <value>CE-6</value>
          <value>CE-7</value>
          <value>CE-8</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:findingStatusList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Open</value>
          <value>CAP Submitted</value>
          <value>CAP Accepted</value>
          <value>In Progress</value>
          <value>Pending Closure Review</value>
          <value>Verifying Effective Closure</value>
          <value>Closed</value>
          <value>Overdue</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:inspectionStatusList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Created</value>
          <value>Planned</value>
          <value>Assigned</value>
          <value>Confirmed</value>
          <value>Reported</value>
          <value>Closed</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:acceptanceStatusList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Pending review</value>
          <value>Accepted</value>
          <value>Rejected</value>
          <value>Returned</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:followUpTypeList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Progress Review</value>
          <value>CAP Verification</value>
          <value>Closure Verification</value>
          <value>Ad-hoc Inquiry</value>
        </list>
      </parameter>
    </constraint>

    <constraint name="vso:evidenceRoleList" type="LIST">
      <parameter name="allowedValues">
        <list>
          <value>Compliance Evidence</value>
          <value>Finding Support</value>
          <value>Progress Evidence</value>
          <value>Closure Evidence</value>
        </list>
      </parameter>
    </constraint>
  </constraints>

  <!-- ========================================================= -->
  <!-- Types -->
  <!-- ========================================================= -->
  <types>

    <!-- ===================== Base VSO Content ====================== -->
    <type name="vso:vsoContent">
      <title>VSO Content</title>
      <parent>cm:content</parent>

      <properties>
        <property name="vso:contentType">
          <title>Tipo de contenido VSO</title>
          <description>VSO business content classification</description>
          <type>d:text</type>
        </property>
      </properties>
    </type>

    <!-- ===================== Inspection ====================== -->
    <type name="vso:inspection">
      <title>Inspección</title>
      <parent>cm:folder</parent>

      <properties>
        <property name="vso:inspectionType">
          <title>Tipo de inspección</title>
          <description>Type of inspection (initial, routine, follow-up)</description>
          <type>d:text</type>
        </property>
        <property name="vso:startDate">
          <title>Fecha de inicio</title>
          <description>Inspection start date</description>
          <type>d:date</type>
        </property>
        <property name="vso:endDate">
          <title>Fecha de cierre</title>
          <description>Inspection end date</description>
          <type>d:date</type>
        </property>
        <property name="vso:inspectionStatus">
          <title>Estatus inspección</title>
          <description>Current inspection lifecycle status</description>
          <type>d:text</type>
          <default>Created</default>
          <constraints>
            <constraint ref="vso:inspectionStatusList"/>
          </constraints>
        </property>
      </properties>

      <mandatory-aspects>
        <aspect>vso:inspectionContext</aspect>
      </mandatory-aspects>
    </type>

    <!-- ================= Inspection Checklist ================= -->
    <type name="vso:inspectionChecklist">
      <title>Lista de Verificación</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:checklistId">
          <title>ID lista de verificación</title>
          <description>Unique identifier of the checklist</description>
          <type>d:text</type>
          <mandatory>true</mandatory>
        </property>
        <property name="vso:scope">
          <title>Alcance lista de verificación</title>
          <description>Checklist scope or inspection area</description>
          <type>d:text</type>
        </property>
        <property name="vso:completionDate">
          <title>Fecha completado</title>
          <description>Date checklist was completed</description>
          <type>d:date</type>
        </property>
      </properties>

      <associations>
        <child-association name="vso:hasChecklistItem">
          <source>
            <mandatory>true</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:checklistItem</class>
            <mandatory>true</mandatory>
            <many>true</many>
          </target>
        </child-association>
      </associations>
    </type>

    <!-- ================= Checklist Item ================= -->
    <type name="vso:checklistItem">
      <title>Checklist Item</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:itemId">
          <title>ID pregunta inspección</title>
          <description>Checklist item instance identifier</description>
          <type>d:text</type>
          <mandatory>true</mandatory>
        </property>
        <property name="vso:itemCode">
          <title>Código pregunta inspección</title>
          <description>Reusable question code shared across checklists</description>
          <type>d:text</type>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
        <property name="vso:requirementText">
          <title>Texto requisito</title>
          <description>Regulatory requirement being assessed</description>
          <type>d:text</type>
        </property>
        <property name="vso:itemVerificationMethod">
          <title>Método de verificación</title>
          <description>Method used to verify compliance</description>
          <type>d:text</type>
        </property>
        <property name="vso:complianceStatus">
          <title>Estado de cumplimiento</title>
          <description>Compliance assessment result</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:complianceStatusList"/>
          </constraints>
        </property>
        <property name="vso:inspectorComment">
          <title>Comentario del inspector</title>
          <description>Inspector observations or remarks</description>
          <type>d:text</type>
        </property>
        <property name="vso:nominalRisk">
          <title>Riesgo nominal</title>
          <description>Nominal risk level associated with the requirement</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:riskLevelList"/>
          </constraints>
        </property>
        <property name="vso:hasOpenPriorFinding">
          <title>Tiene hallazgos previos abiertos?</title>
          <description>Precomputed flag to speed up checklist searches for related prior findings that are not closed</description>
          <type>d:boolean</type>
          <default>false</default>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
      </properties>

      <associations>
        <association name="vso:hasFinding">
          <source>
            <mandatory>false</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:finding</class>
            <mandatory>false</mandatory>
            <many>false</many>
          </target>
        </association>
        <association name="vso:relatedPriorFinding">
          <source>
            <mandatory>false</mandatory>
            <many>true</many>
          </source>
          <target>
            <class>vso:finding</class>
            <mandatory>false</mandatory>
            <many>true</many>
          </target>
        </association>
      </associations>

      <mandatory-aspects>
        <aspect>vso:evidenceReferences</aspect>
        <aspect>vso:regulatoryTraceability</aspect>
        <aspect>vso:inspectionContext</aspect>
        <aspect>vso:serviceContext</aspect>
      </mandatory-aspects>
    </type>

    <!-- ================= Evidence Item ================= -->
    <type name="vso:evidenceItem">
      <title>Evidence Item</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:evidenceId">
          <title>ID evidencia</title>
          <description>Unique evidence identifier</description>
          <type>d:text</type>
          <mandatory>true</mandatory>
        </property>
        <property name="vso:evidenceType">
          <title>Tipo de evidencia</title>
          <description>Type of evidence (document, photo, log)</description>
          <type>d:text</type>
        </property>
        <property name="vso:source">
          <title>Fuente de evidencia</title>
          <description>Origin or system from which evidence was collected</description>
          <type>d:text</type>
        </property>
        <property name="vso:collectionDate">
          <title>Fecha de obtención</title>
          <description>Date evidence was collected</description>
          <type>d:date</type>
        </property>
        <property name="vso:evidenceRole">
          <title>Rol de evidencia</title>
          <description>Role of evidence in proving compliance or finding resolution</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:evidenceRoleList"/>
          </constraints>
        </property>
      </properties>

      <mandatory-aspects>
        <aspect>vso:evidenceIntegrity</aspect>
        <aspect>vso:inspectionContext</aspect>
        <aspect>vso:serviceContext</aspect>
      </mandatory-aspects>
    </type>

    <!-- ================= Finding ================= -->
    <type name="vso:finding">
      <title>Finding</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:findingId">
          <title>ID hallazgo</title>
          <description>Finding identifier</description>
          <type>d:text</type>
          <mandatory>true</mandatory>
        </property>
        <property name="vso:findingLevel">
          <title>Clasificación hallazgo</title>
          <description>Finding classification</description>
          <type>d:text</type>
          <default>Non-Compliance</default>
          <constraints>
            <constraint ref="vso:findingLevelList"/>
          </constraints>
        </property>
        <property name="vso:riskClassification">
          <title>Clasificación de riesgo</title>
          <description>Risk classification associated with the detected discrepancy</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:riskLevelList"/>
          </constraints>
        </property>
        <property name="vso:requirementBreached">
          <title>Regulación incumplida</title>
          <description>Regulatory reference breached</description>
          <type>d:text</type>
        </property>
        <property name="vso:checklistItemCode">
          <title>Código pregunta relacionada</title>
          <description>Question code associated with this finding</description>
          <type>d:text</type>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
        <property name="vso:description">
          <title>Descripción hallazgo</title>
          <description>Detailed finding description</description>
          <type>d:text</type>
        </property>
        <property name="vso:findingStatus">
          <title>Estatus hallazgo</title>
          <description>Finding lifecycle status</description>
          <type>d:text</type>
          <default>Open</default>
          <constraints>
            <constraint ref="vso:findingStatusList"/>
          </constraints>
        </property>
        <property name="vso:submissionDeadline">
          <title>Fecha limite de envio</title>
          <description>Deadline by which the regulated entity must submit a corrective action plan</description>
          <type>d:date</type>
        </property>
        <property name="vso:findingClosureDate">
          <title>Fecha de cierre</title>
          <description>Date on which the finding was formally closed by the oversight authority</description>
          <type>d:date</type>
        </property>
        <property name="vso:dateIssued">
          <title>Fecha de apertura</title>
          <description>Date the finding was formally raised, set on creation from the checklist upload</description>
          <type>d:date</type>
        </property>
        <property name="vso:lastStatusChange">
          <title>Fecha ultimo cambio de estatus</title>
          <description>Date the findingStatus was last updated, maintained by the Node backend on each transition</description>
          <type>d:date</type>
        </property>
        <property name="vso:resolutionDeadline">
          <title>Fecha limite de resolución</title>
          <description>Deadline by which the finding must be resolved</description>
          <type>d:date</type>
        </property>
      </properties>

      <associations>
        <child-association name="vso:hasFollowUp">
          <source>
            <mandatory>false</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:followUpReport</class>
            <mandatory>false</mandatory>
            <many>true</many>
          </target>
        </child-association>
        <child-association name="vso:hasCorrectiveAction">
          <source>
            <mandatory>false</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:correctiveAction</class>
            <mandatory>false</mandatory>
            <many>true</many>
          </target>
        </child-association>
      </associations>

      <mandatory-aspects>
        <aspect>vso:evidenceReferences</aspect>
        <aspect>vso:regulatoryTraceability</aspect>
        <aspect>vso:inspectionContext</aspect>
        <aspect>vso:serviceContext</aspect>
      </mandatory-aspects>
    </type>

    <!-- ================= Corrective Action ================= -->
    <type name="vso:correctiveAction">
      <title>Corrective Action</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:capId">
          <title>ID Plan de Acción Correctiva</title>
          <description>Corrective Action Plan identifier</description>
          <type>d:text</type>
        </property>
        <property name="vso:proposedAction">
          <title>Acción propuesta</title>
          <description>Description of corrective action</description>
          <type>d:text</type>
        </property>
        <property name="vso:responsibleEntity">
          <title>Entidad responsable</title>
          <description>Entity responsible for implementation</description>
          <type>d:text</type>
        </property>
        <property name="vso:dueDate">
          <title>Fecha de vencimiento</title>
          <description>Corrective action due date</description>
          <type>d:date</type>
        </property>
        <property name="vso:acceptanceStatus">
          <title>Estado de aceptación</title>
          <description>Acceptance status by authority</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:acceptanceStatusList"/>
          </constraints>
        </property>
      </properties>

      <associations>
        <child-association name="vso:verifiedBy">
          <source>
            <mandatory>false</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:followUpReport</class>
            <mandatory>false</mandatory>
            <many>true</many>
          </target>
        </child-association>
      </associations>

      <mandatory-aspects>
        <aspect>cm:versionable</aspect>
        <aspect>vso:inspectionContext</aspect>
        <aspect>vso:serviceContext</aspect>
      </mandatory-aspects>
    </type>

    <!-- ================= Follow-up Report ================= -->
    <type name="vso:followUpReport">
      <title>Follow-up Report</title>
      <parent>vso:vsoContent</parent>

      <properties>
        <property name="vso:followUpId">
          <title>ID seguimiento</title>
          <description>Follow-up report identifier</description>
          <type>d:text</type>
        </property>
        <property name="vso:followUpType">
          <title>Tipo de seguimiento</title>
          <description>Type of follow-up activity</description>
          <type>d:text</type>
          <mandatory>true</mandatory>
          <constraints>
            <constraint ref="vso:followUpTypeList"/>
          </constraints>
        </property>
        <property name="vso:followUpDate">
          <title>Fecha de seguimiento</title>
          <description>Date (and time) the follow-up was conducted in the field, as recorded by the checklist app</description>
          <type>d:datetime</type>
        </property>
        <property name="vso:percentComplete">
          <title>Porcentaje completado</title>
          <description>Percentage of corrective action completion</description>
          <type>d:int</type>
        </property>
        <property name="vso:followUpClosureDate">
          <title>Fecha de cierre</title>
          <description>Date corrective action was closed</description>
          <type>d:date</type>
        </property>
        <property name="vso:closureVerificationMethod">
          <title>Método de verificación</title>
          <description>Method used to verify effectiveness</description>
          <type>d:text</type>
        </property>
        <property name="vso:effectivenessConfirmed">
          <title>Efectividad confirmada?</title>
          <description>Effectiveness verification result</description>
          <type>d:boolean</type>
        </property>
        <property name="vso:followUpComment">
          <title>Comentario de seguimiento</title>
          <description>Free-text comment recorded during the follow-up</description>
          <type>d:text</type>
        </property>
      </properties>

      <associations>
        <association name="vso:relatedCorrectiveAction">
          <source>
            <mandatory>false</mandatory>
            <many>false</many>
          </source>
          <target>
            <class>vso:correctiveAction</class>
            <mandatory>false</mandatory>
            <many>false</many>
          </target>
        </association>
      </associations>

      <mandatory-aspects>
        <aspect>vso:evidenceReferences</aspect>
        <aspect>vso:inspectionContext</aspect>
        <aspect>vso:serviceContext</aspect>
      </mandatory-aspects>
    </type>

  </types>

  <!-- ========================================================= -->
  <!-- Aspects -->
  <!-- ========================================================= -->
  <aspects>

    <aspect name="vso:evidenceReferences">
      <title>Evidence References</title>
      <associations>
        <association name="vso:relatedEvidence">
          <source>
            <mandatory>false</mandatory>
            <many>true</many>
          </source>
          <target>
            <class>vso:evidenceItem</class>
            <mandatory>false</mandatory>
            <many>true</many>
          </target>
        </association>
      </associations>
    </aspect>

    <aspect name="vso:inspectionContext">
      <title>Inspection Context</title>
      <properties>
        <property name="vso:inspectionId">
          <title>ID inspección</title>
          <description>Associated inspection identifier</description>
          <type>d:text</type>
        </property>
        <property name="vso:locationId">
          <title>ID ubicacion inspeccion</title>
          <description>Inspection location identifier</description>
          <type>d:text</type>
        </property>
        <property name="vso:locationCode">
          <title>Código ubicacion inspeccion</title>
          <description>Stable location business code (for example ICAO code)</description>
          <type>d:text</type>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
        <property name="vso:locationName">
          <title>Nombre ubicacion inspeccion</title>
          <description>Inspection location name</description>
          <type>d:text</type>
        </property>
      </properties>
    </aspect>

    <aspect name="vso:serviceContext">
      <title>Service Context</title>
      <properties>
        <property name="vso:specialtyId">
          <title>ID especialidad</title>
          <description>Canonical specialty identifier</description>
          <type>d:text</type>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
        <property name="vso:specialtyCode">
          <title>Código especialidad</title>
          <description>Human-friendly specialty code used in search and integrations</description>
          <type>d:text</type>
          <index enabled="true">
            <atomic>true</atomic>
            <stored>false</stored>
            <tokenised>false</tokenised>
          </index>
        </property>
        <property name="vso:specialtyName">
          <title>Nombre especialidad</title>
          <description>Display name snapshot for specialty</description>
          <type>d:text</type>
        </property>
        <property name="vso:providerId">
          <title>ID proveedor u operador</title>
          <description>Service provider identifier under oversight</description>
          <type>d:text</type>
        </property>
        <property name="vso:providerName">
          <title>Nombre proveedor u operador</title>
          <description>Service provider name under oversight</description>
          <type>d:text</type>
        </property>
      </properties>
    </aspect>

    <aspect name="vso:regulatoryTraceability">
      <title>Regulatory Traceability</title>
      <properties>
        <property name="vso:icaoReference">
          <title>Referencia SARPs OACI</title>
          <description>ICAO SARPs reference</description>
          <type>d:text</type>
        </property>
        <property name="vso:nationalRegulation">
          <title>Referencia regulación nacional</title>
          <description>National regulation reference</description>
          <type>d:text</type>
        </property>
        <property name="vso:ceMapping">
          <title>Elemento crítico relacionado</title>
          <description>USOAP Critical Element mapping</description>
          <type>d:text</type>
          <constraints>
            <constraint ref="vso:ceList"/>
          </constraints>
        </property>
      </properties>
    </aspect>

    <aspect name="vso:evidenceIntegrity">
      <title>Evidence Integrity</title>
      <properties>
        <property name="vso:hashValue">
          <title>Hash criptográfico</title>
          <description>Cryptographic hash of evidence</description>
          <type>d:text</type>
        </property>
        <property name="vso:immutable">
          <title>Inmutable?</title>
          <description>Indicates if evidence is sealed</description>
          <type>d:boolean</type>
        </property>
        <property name="vso:sealedDate">
          <title>Fecha sellado</title>
          <description>Date evidence was sealed</description>
          <type>d:date</type>
        </property>
      </properties>
    </aspect>

  </aspects>

</model>
